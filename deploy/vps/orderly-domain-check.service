[Unit]
Description=Authorize HTTPS issuance for registered Orderly stores
After=docker.service network-online.target
[Service]
ExecStart=/usr/bin/python3 /opt/orderly-shop/caddy-domain-check.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6
[Install]
WantedBy=multi-user.target
